#!/usr/bin/env bash
# Refuse commits that reference prior-art projects, then report any story this commit would leave
# implemented but open. Install with:
#     git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-provenance.sh"

# X-115. This is a report and never a refusal — `check-story-closure.py`'s docstring says why, and
# its exit code is discarded here so that stays true whatever the script decides later. The hook is
# the point of it: `A-16` sat implemented-but-open for three days before a wave selection pass read
# its status and dispatched it a second time, and the commit that ticked its rows passed through
# here. Only commits that touch the board pay for it, which is every commit that could create this.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- docs/stories)" ]; then
    "$root/scripts/check-story-closure.py" --staged || true
fi
