poll_method epoll
sip_listen 127.0.0.1:5090
sip_certificate /proof/server-combined.pem
call_local_timeout 30
call_max_calls 1
audio_buffer 40
audio_player aubridge,proof
audio_source aubridge,proof
audio_level yes
ausrc_format s16
auplay_format s16
auenc_format s16
audec_format s16
rtp_ports 12400-12500
rtcp_mux no
jitter_buffer_delay 2-4
rtp_stats yes
net_interface 127.0.0.1
module_path /usr/lib/baresip/modules
module g711.so
module aubridge.so
module srtp.so
module_tmp account.so
