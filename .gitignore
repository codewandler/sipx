/target
**/*.rs.bk
Cargo.lock.orig

# Fuzzing artifacts
/fuzz/target
/fuzz/artifacts
/fuzz/corpus
/fuzz/Cargo.lock

# Agent worktrees. Scratch checkouts live inside the repo, each with its own multi-gigabyte
# target/, so an `add -A` here would be both wrong and enormous. Scoped to the subdirectory rather
# than to /.claude so that tracked settings under it stay committable.
/.claude/worktrees/

# Local research and scratch material — must never be committed.
/notes/
/research/
/scratch/
*.local.md

# Generated by tests/interop/run.sh; a stale copy authenticates nothing while the server still
# answers, which looks exactly like a client bug. Per peer, because a peer is a directory.
/tests/interop/*/dbtext/

# Recordings produced by tests and manual runs
*.wav.out
/recordings/

# Generated per interop run: a committed certificate is a committed private key. Every peer gets
# its own, so this has to match every peer — a pattern naming one of them silently commits the
# next one's key.
/tests/interop/*/tls/
